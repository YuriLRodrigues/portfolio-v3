# Usada no sitemap, no robots.txt e nas metatags Open Graph.
# Em produção, a URL pública do site (o workflow do GitHub Pages já define).
NEXT_PUBLIC_SITE_URL=https://yurilrodrigues.github.io/portfolio-v3

