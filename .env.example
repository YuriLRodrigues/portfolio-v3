# Envio do formulário de contato (app/api/contact).
# Sem estas variáveis a rota responde 503 e o formulário mostra o aviso de
# "envio ainda não configurado" — o site continua no ar normalmente.
#
# Resend tem plano gratuito: 3.000 e-mails por mês, 100 por dia.
# 1. Crie a conta em https://resend.com e gere uma API key em API Keys.
# 2. Cole a key abaixo.
# 3. Em CONTACT_NOTIFY_EMAIL ponha o endereço onde você quer receber.
# 4. CONTACT_FROM_EMAIL é opcional: sem domínio verificado, deixe comentado e
#    o envio sai de onboarding@resend.dev, que já funciona no plano gratuito.
#    Com domínio próprio verificado no Resend, use algo como
#    "Portfolio <contato@seudominio.com>" para não cair em spam.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_NOTIFY_EMAIL=rodriguesyuri769@gmail.com
# CONTACT_FROM_EMAIL="Portfolio <contato@seudominio.com>"

# Usada no sitemap, no robots.txt e nas metatags Open Graph.
# Em produção, a URL pública do site.
NEXT_PUBLIC_SITE_URL=https://yurilrodrigues-dev.vercel.app
