{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "on"
  },
  "tailwindCSS.experimental.configFile": "app/globals.css",
  "files.associations": {
    "*.css": "tailwindcss"
  }
}
